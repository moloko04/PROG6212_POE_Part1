@model RaceDay.Web.Models.EventViewModel

@{
    ViewData["Title"] = Model.EventName;
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2>@Model.EventName</h2>
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.EventDate.ToString("dddd, dd MMMM yyyy")</h5>
            <p class="lead">@Model.Location</p>
            <p>@Model.Description</p>

            <hr />

            <h4>Available Categories</h4>
            @if (Model.Categories != null && Model.Categories.Any())
            {
                <ul class="list-group mb-3">
                    @foreach (var cat in Model.Categories)
                    {
                        <li class="list-group-item">@cat.CategoryName</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No categories available yet.</p>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <form asp-action="Enrol" method="post">
                <input type="hidden" name="eventId" value="@Model.EventID" />
                <button type="submit" class="btn btn-success btn-lg w-100">Enrol Now</button>
            </form>
        </div>
        <div class="card-footer text-muted">
            <a asp-action="Index">Back to Events</a>
        </div>
    </div>
</div>