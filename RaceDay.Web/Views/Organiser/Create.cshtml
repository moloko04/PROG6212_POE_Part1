@model RaceDay.Web.Models.EventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0">Create New Event</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="EventName" class="control-label">Event Name</label>
                        <input asp-for="EventName" class="form-control" required />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="EventDate" class="control-label">Date & Time</label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" required />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Location" class="control-label">Location</label>
                        <input asp-for="Location" class="form-control" required />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label">Event Banner Image</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    </div>

                    <button type="submit" class="btn btn-success w-100">Create Event</button>
                </form>
            </div>
        </div>
    </div>
</div>